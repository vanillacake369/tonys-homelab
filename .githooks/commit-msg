#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
subject="$(sed -n '1p' "$message_file")"

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

types='feat|fix|refactor|docs|test|chore|build|ci'
scopes='ansible|bookorbit|ci|cni|deps|docs|flux|gitops|hooks|just|k8s|nix|platform|policy|registry|secrets|ssh|storage|topology|users'

if [ "${#subject}" -gt 100 ]; then
  echo "Invalid commit message: header must not exceed 100 characters" >&2
  exit 1
fi

if [[ ! "$subject" =~ ^($types)\(($scopes)\):[[:space:]][^[:space:]].* ]]; then
  echo "Invalid commit message: $subject" >&2
  echo "Expected: type(scope): description" >&2
  echo "Allowed types: ${types//|/, }" >&2
  echo "Allowed scopes: ${scopes//|/, }" >&2
  exit 1
fi
