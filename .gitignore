# Build results
result
result-*

# Auto-generated SSH config (just _gen-ssh-config)
.cache/

# Hardware configuration (machine-specific)
hosts/*/hardware-configuration.nix

# Secrets and keys
*.key
*.pem
# SOPS-encrypted payloads are deploy inputs and may be committed after review.
!**/*.enc.yaml
!secrets/secrets.yaml
# Local plaintext secret work files must stay out of Git.
secrets/*.plain.yaml
secrets/*.local.yaml
secrets/*.decrypted.yaml
secrets/*.tmp.yaml
!**/secret.example.yaml
!**/secrets.example.yaml
secrets/*.pub
secrets/ssh-public-key.txt
secrets/vm-master.key
kubeconfig
kubeconfig.*
# lib/homelab-constants.nix

# Local/generated helper output
k3d/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
